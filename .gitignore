# Build artifacts
/bin/
# Bare binary from `go build ./cmd/remotemic` (Taskfile builds go to /bin/).
/remotemic
*.exe
*.test
*.out

# GoReleaser output directory (`goreleaser release [--snapshot]` writes here).
/dist/

# Coverage and profiling
coverage.out
coverage.txt
*.cov
*.prof
*.pprof

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/
.serena/
.claude/

# Runtime artifacts
*.pid
# Run lock a serving appliance holds beside its config (either config extension).
*.yaml.lock
*.yml.lock

# Local tool caches
cache/

# Web UI test build output (web:test compiles here before node --test)
web/.test-out/

# Compiled web UI. Generated by `task web:build` (tsc) and embedded into the
# binary at build time via web/embed.go. Kept out of git so PRs and reviews are
# not flooded with compiled JS/CSS churn; `task build` regenerates it first.
web/dist/

# CodeGraph index database (local code intelligence)
.codegraph/

# Local-only design and planning notes; never part of the published repo.
docs/
